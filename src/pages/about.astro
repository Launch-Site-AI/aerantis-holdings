---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { aboutImage } from '../config/images';

const principles = [
  {
    title: 'Considered',
    body: 'Every project is approached with care, discretion, and long-term intent. TODO(owner): expand.',
  },
  {
    title: 'Coordinated',
    body: 'End-to-end coordination keeps every stage of a project on course. TODO(owner): expand.',
  },
  {
    title: 'Committed',
    body: 'A dedicated partner focused on delivering enduring value. TODO(owner): expand.',
  },
];
---

<BaseLayout title="About" description={`About ${brand.name} — a considered approach to property.`}>
  <Header slot="header" />

  <Banner title="About Aerantis" />

  <section class="bg-background py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-start gap-12 px-4 sm:px-6 lg:grid-cols-[5fr_6fr] lg:gap-16">
      <div class="relative">
        <div class="border border-primary/40 p-2">
          <div class="relative aspect-[4/5] w-full overflow-hidden">
            {aboutImage ? (
              <Image
                src={aboutImage}
                alt="Aerantis Holdings"
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 42vw, 100vw"
                loading="lazy"
                class="size-full object-cover"
              />
            ) : (
              <div class="flex size-full items-center justify-center bg-surface">
                <span class="text-xs uppercase tracking-[0.3em] text-text-muted">TODO(owner): image</span>
              </div>
            )}
            <div class="pointer-events-none absolute inset-3 border border-primary/50" aria-hidden="true"></div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          Our Story
        </span>
        <h2 class="font-heading text-h2 font-medium leading-tight text-text">
          A considered approach to property.
        </h2>
        <p class="text-text-muted leading-relaxed">
          TODO(owner): a paragraph introducing Aerantis Holdings — origin, focus, and the kind of clients we work with.
        </p>
        <p class="text-text-muted leading-relaxed">
          TODO(owner): a second paragraph on the way Aerantis operates — discretion, discipline, and the long view on value.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-primary/20 bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          Principles
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
        </span>
        <h2 class="mt-4 font-heading text-h2 font-medium leading-tight text-text">
          How we work.
        </h2>
      </div>

      <ul class="grid grid-cols-1 gap-px bg-border md:grid-cols-3" role="list">
        {principles.map(({ title, body }) => (
          <li class="bg-background p-8">
            <div class="mb-6 h-px w-10 bg-primary" aria-hidden="true"></div>
            <h3 class="font-heading text-h3 font-medium leading-snug text-text">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{body}</p>
          </li>
        ))}
      </ul>

      <p class="mt-12 text-center text-xs uppercase tracking-[0.28em] text-text-muted">
        TODO(owner): supply team profiles to reinstate the "Our Team" section.
      </p>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
