---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { aboutImage } from '../config/images';

const principles = [
  {
    title: 'Integrity',
    // TODO(owner): refine — pillar bodies are Task-50 first-pass drafts.
    body: 'Honest advice, transparent decisions, and outcomes that hold up long after handover.',
  },
  {
    title: 'Professionalism',
    // TODO(owner): refine.
    body: 'Considered engagements delivered with the discipline of a lead-adviser mindset.',
  },
  {
    title: 'Reliability',
    // TODO(owner): refine.
    body: 'Consistent follow-through on every commitment, every stage, every project.',
  },
  {
    title: 'Long-term Relationships',
    // TODO(owner): refine.
    body: 'Client partnerships that outlast individual projects and compound over time.',
  },
];
---

<BaseLayout title="About" description={`About ${brand.name} — a considered approach to property.`}>
  <Header slot="header" />

  <Banner title="About Aerantis" eyebrow="Who we are" />

  <section class="bg-background py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-start gap-12 px-4 sm:px-6 lg:grid-cols-[5fr_6fr] lg:gap-16">
      <div class="relative">
        <div class="border border-primary/40 p-2">
          <div class="relative aspect-[5/2] w-full overflow-hidden">
            {aboutImage ? (
              <Image
                src={aboutImage}
                alt="Aerantis Holdings client engagement"
                widths={[480, 720, 960, 1099]}
                sizes="(min-width: 1024px) 42vw, 100vw"
                loading="lazy"
                class="size-full object-cover"
              />
            ) : (
              <div class="flex size-full items-center justify-center bg-surface">
                <span class="text-xs uppercase tracking-[0.3em] text-text-muted">TODO(owner): image</span>
              </div>
            )}
            <div class="pointer-events-none absolute inset-3 border border-primary/50" aria-hidden="true"></div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          Our Story
        </span>
        <h2 class="font-heading text-h2 font-medium leading-tight text-text">
          A considered approach to property.
        </h2>
        <p class="text-text-muted leading-relaxed">
          Aerantis Holdings provides professional property solutions, project coordination and client-focused support throughout Melbourne.
        </p>
        <p class="text-text-muted leading-relaxed">
          We believe successful projects begin with trust, clear communication and attention to detail.
        </p>
        <p class="text-text-muted leading-relaxed">
          Rather than offering one standard solution, we work closely with every client to deliver practical, tailored outcomes that reflect their goals and expectations.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-primary/20 bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          Principles
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
        </span>
        <h2 class="mt-4 font-heading text-h2 font-medium leading-tight text-text">
          Our commitment is built on…
        </h2>
      </div>

      <ul class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-4" role="list">
        {principles.map(({ title, body }) => (
          <li class="bg-background p-8">
            <div class="mb-6 h-px w-10 bg-primary" aria-hidden="true"></div>
            <h3 class="font-heading text-h3 font-medium leading-snug text-text">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-text-muted">{body}</p>
          </li>
        ))}
      </ul>

      {/* Team section deliberately omitted — owner reply did not supply team
          profiles. Task 50 removes the visible placeholder that previously
          appeared on the deployed page. To reinstate later, add a `team`
          array and render a section here. */}
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
