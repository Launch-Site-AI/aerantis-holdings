---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';

const services = [
  {
    title: 'Property Solutions',
    description:
      'Trusted property solutions tailored to each client, from acquisition and holding through to disposition. TODO(owner): describe representative engagements, sectors, and outcomes.',
  },
  {
    title: 'Project Coordination',
    description:
      'End-to-end coordination across every stage of a project — planning, delivery, and hand-over — with a single point of accountability. TODO(owner): outline the typical project rhythm and the disciplines Aerantis coordinates.',
  },
  {
    title: 'Tailored Support',
    description:
      'Dedicated support built around long-term value: discreet advisory, ongoing stewardship, and considered decisions on your behalf. TODO(owner): detail the support cadence and the profile of clients served.',
  },
];

const icons = [
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 21V7l8-4 8 4v14" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 21h16M9 21v-6h6v6M9 11h.01M12 11h.01M15 11h.01" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 6.5a2 2 0 100-4 2 2 0 000 4zm12 15a2 2 0 100-4 2 2 0 000 4zm0-15a2 2 0 100-4 2 2 0 000 4zM6 21.5a2 2 0 100-4 2 2 0 000 4z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 4.5h8M8 19.5h8M6 6.5v11M18 6.5v11" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3l4 5-4 8-4-8 4-5z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 18c2 2 5 3 8 3s6-1 8-3" />',
];
---

<BaseLayout title="Services" description={`Explore how ${brand.name} approaches property solutions, project coordination, and tailored support.`}>
  <Header slot="header" />

  <Banner title="Our Services" eyebrow="What we do" />

  <section class="bg-background py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          What We Do
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
        </span>
        <h2 class="mt-4 font-heading text-h2 font-medium leading-tight text-text">
          Capabilities shaped around long-term value.
        </h2>
        <p class="mt-4 text-text-muted leading-relaxed">
          Three considered capabilities delivered with discretion, discipline, and a partner's mindset.
        </p>
      </div>

      <ul class="grid grid-cols-1 gap-px bg-border md:grid-cols-3" role="list">
        {services.map((service, i) => (
          <li class="flex flex-col bg-surface p-8">
            <div class="mb-6 flex size-14 items-center justify-center border border-primary/70 text-primary">
              <svg class="size-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i % icons.length]} />
            </div>
            <h3 class="font-heading text-h3 font-medium leading-snug text-text">{service.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
