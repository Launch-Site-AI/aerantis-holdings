---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import { brand } from '../../config/brand';
import { client } from '../../data/client';

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};

const hasConfirmedAddress = Boolean(client.address.addressLocality);

const phones = [
  { label: 'Direct',              tel: client.phoneForTel,       display: client.phoneFormatted },
  { label: 'Office / Enquiries',  tel: client.phoneOfficeForTel, display: client.phoneOfficeFormatted },
].filter((p) => p.tel && p.display);

const hasHours = client.businessHours.length > 0;
const hasInstagram = Boolean(client.socials.instagram);
const hasServiceArea = Boolean(client.serviceArea);
const instagramHandle = client.socials.instagram
  ? `@${client.socials.instagram.replace(/^https?:\/\/(www\.)?instagram\.com\//, '').replace(/\/$/, '')}`
  : '';

const inputClass =
  'min-h-[48px] w-full border border-primary/30 bg-surface px-4 py-3 text-text placeholder:text-text-muted transition-colors focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary/60';
---

<BaseLayout title="Contact" description={`Request a consultation with ${brand.name}.`}>
  <Header slot="header" />

  <Banner title="Contact" eyebrow="Get in touch" />

  <section class="bg-background py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-14 px-4 sm:px-6 lg:grid-cols-5 lg:gap-16">

      <div class="lg:col-span-3">
        <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
          <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
          Get in Touch
        </span>
        <h2 class="mt-4 font-heading text-h2 font-medium leading-tight text-text">
          Request a Consultation
        </h2>
        <p class="mt-4 mb-10 text-text-muted leading-relaxed">
          Share a few details and Aerantis will be in touch to arrange an initial conversation. TODO(owner): finalise wording and expected response window.
        </p>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action={withBase('/contact/success')}
          class="flex flex-col gap-6"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="flex flex-col gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Name <span class="text-primary-light" aria-hidden="true">*</span></span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Email <span class="text-primary-light" aria-hidden="true">*</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Phone</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              class={inputClass}
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-xs font-semibold uppercase tracking-[0.24em] text-primary">Message <span class="text-primary-light" aria-hidden="true">*</span></span>
            <textarea
              name="message"
              rows="5"
              required
              class={`${inputClass} min-h-[144px] resize-y`}
            ></textarea>
          </label>

          <button
            type="submit"
            class="group mt-2 inline-flex min-h-[48px] cursor-pointer items-center justify-center gap-3 self-start border border-primary bg-primary px-10 py-3 text-sm font-semibold uppercase tracking-[0.28em] text-near-black transition-colors hover:bg-primary-light hover:border-primary-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            Send Message
            <svg class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </form>
      </div>

      <aside class="space-y-10 lg:col-span-2 lg:border-l lg:border-primary/20 lg:pl-14">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Call</h3>
          <ul class="mt-3 space-y-4">
            {phones.map(({ label, tel, display }) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="flex flex-col gap-0.5">
                  <span class="text-[10px] font-semibold uppercase tracking-[0.24em] text-text-muted">{label}</span>
                  <a href={`tel:${tel}`} class="text-text transition-colors hover:text-primary-light">{display}</a>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Email</h3>
          <a href={`mailto:${client.email}`} class="mt-3 flex items-center gap-3 break-all text-text transition-colors hover:text-primary-light">
            <svg class="size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {client.email}
          </a>
        </div>

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Website</h3>
          <a href={client.domain} target="_blank" rel="noopener noreferrer" class="mt-3 flex items-center gap-3 break-all text-text transition-colors hover:text-primary-light">
            <svg class="size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 0a13 13 0 010 18M3.6 9h16.8M3.6 15h16.8" />
            </svg>
            {client.domain.replace(/^https?:\/\//, '')}
          </a>
        </div>

        {hasInstagram && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Instagram</h3>
            <a href={client.socials.instagram} target="_blank" rel="noopener noreferrer" class="mt-3 flex items-center gap-3 text-text transition-colors hover:text-primary-light">
              <svg class="size-4 shrink-0 text-primary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              {instagramHandle}
            </a>
          </div>
        )}

        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Visit</h3>
          <div class="mt-3 flex items-start gap-3 text-text-muted">
            <svg class="mt-1 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21s7-6.75 7-12a7 7 0 10-14 0c0 5.25 7 12 7 12z" />
              <circle cx="12" cy="9" r="2.5" stroke-width="1.5" />
            </svg>
            {hasConfirmedAddress ? (
              <span>
                {client.address.addressLocality}, {client.address.addressRegion}, Australia
              </span>
            ) : (
              <span class="text-xs uppercase tracking-[0.24em]">TODO(owner): supply address.</span>
            )}
          </div>
        </div>

        {hasServiceArea && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Service Area</h3>
            <p class="mt-3 text-text-muted">
              {client.serviceArea}
            </p>
          </div>
        )}

        {hasHours && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Hours</h3>
            <ul class="mt-3 space-y-2 text-text-muted">
              {client.businessHours.map(({ days, hours }) => (
                <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:gap-3">
                  <span class="text-text">{days}</span>
                  <span class="hidden text-primary/60 sm:inline" aria-hidden="true">·</span>
                  <span>{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
