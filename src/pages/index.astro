---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const siteOrigin = (Astro.site?.toString() ?? brand.url).replace(/\/$/, '');
const homeUrl = `${siteOrigin}${normalizedBase}`;
const asset = (path: string) => `${siteOrigin}${normalizedBase}${path.replace(/^\/+/, '')}`;

// ─────────────────────────────────────────────────────────────────────────────
// JSON-LD — Organization
// ─────────────────────────────────────────────────────────────────────────────
// Schema shape matches the owner's WhatsApp reply (documentation/planning/
// 09-owner-respond-information.md § 2). Every field emitted has a visible
// on-page counterpart per D5 (content-truth rule):
//
//   name             → Header wordmark, Hero, Footer
//   legalName        → Footer bottom-bar compliance line
//   taxID            → Footer bottom-bar compliance line
//   telephone (both) → Footer Contact col + Contact-page aside (Task 47)
//   email            → Footer + Contact aside
//   address          → Footer + Contact Visit (city / region / country only)
//   areaServed       → Contact aside "Service Area" row (Task 47)
//   sameAs           → Footer social row + Contact aside Instagram row
//
// availableLanguage is sourced from client.availableLanguages so a single
// data edit propagates to both ContactPoint entries and the visible
// Contact-page "We conduct enquiries in English and Persian." line.
// D5 (content-truth) held: keep the two in sync when adding a new language.
//
// Prohibited @types (owner directive): RealEstateAgent, ProfessionalService,
// ConstructionCompany, HomeAndConstructionBusiness, GeneralContractor,
// LocalBusiness, Attorney, FinancialService, HomeGoodsStore.
// ─────────────────────────────────────────────────────────────────────────────

const contactPoints: Record<string, unknown>[] = [];
if (client.phoneForTel) {
  contactPoints.push({
    '@type': 'ContactPoint',
    telephone: client.phoneForTel,
    contactType: 'customer service',
    areaServed: 'AU',
    availableLanguage: [...client.availableLanguages],
  });
}
if (client.phoneOfficeForTel) {
  contactPoints.push({
    '@type': 'ContactPoint',
    telephone: client.phoneOfficeForTel,
    contactType: 'office',
    areaServed: 'AU',
    availableLanguage: [...client.availableLanguages],
  });
}

const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${homeUrl}#organization`,
  name: brand.name,
  legalName: client.legalName,
  taxID: client.taxId,
  url: homeUrl,
  email: client.email,
  telephone: client.phoneForTel,
  logo: {
    '@type': 'ImageObject',
    url: asset('og-image.png'),
  },
  image: asset('og-image.png'),
  address: {
    '@type': 'PostalAddress',
    addressLocality: client.address.addressLocality,
    addressRegion: client.address.addressRegion,
    addressCountry: client.address.addressCountry,
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: client.serviceArea,
  },
  sameAs: [client.socials.instagram].filter(Boolean),
  contactPoint: contactPoints,
  // Populated by Task 51 (Step 11 Decision 2). Every Service.name below
  // matches a visible label on the homepage Services strip or the long-form
  // Services page. `category` groups sub-services under the 3 headline
  // capabilities shown on those surfaces.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: [
      { '@type': 'Service', name: 'Property Maintenance',         category: 'Property Solutions' },
      { '@type': 'Service', name: 'Property Improvements',        category: 'Property Solutions' },
      { '@type': 'Service', name: 'Facility Support',             category: 'Property Solutions' },
      { '@type': 'Service', name: 'Renovation Coordination',      category: 'Project Coordination' },
      { '@type': 'Service', name: 'Project Management',           category: 'Project Coordination' },
      { '@type': 'Service', name: 'Commercial Property Support',  category: 'Project Coordination' },
      { '@type': 'Service', name: 'Residential Property Support', category: 'Project Coordination' },
      { '@type': 'Service', name: 'Client Consultation',          category: 'Client Support' },
      { '@type': 'Service', name: 'Business Support Services',    category: 'Client Support' },
    ],
  },
};
---

<BaseLayout
  title={brand.name}
  description="Aerantis Holdings — trusted property solutions, project coordination, and client support, delivering long-term value for every client."
  schema={schema}
>
  <Header slot="header" transparent />

  <Hero
    topper="Professional Property Solutions"
    subline="Built on Trust · Driven by Quality"
    headingLines={['Creating Value.', 'Inspiring Confidence.']}
    description={brand.description}
    ctaLabel="Request a Consultation"
    ctaHref="/contact"
    secondaryLabel="Explore Services"
    secondaryHref="/services"
  />
  <TrustBar />
  <Services />
  <About />
  <Projects />
  <CTA />

  <Footer slot="footer" />
</BaseLayout>
