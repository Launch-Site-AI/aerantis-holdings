---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Projects from '../components/Projects.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';

const hasConfirmedAddress = Boolean(client.address.addressLocality);
const hasConfirmedPhone =
  client.phoneForTel && !client.phoneForTel.startsWith('TODO(');

// TODO(owner): confirm best schema.org @type — Organization vs
// RealEstateAgent vs ProfessionalService.
const schema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: client.name,
  email: client.email,
  url: client.domain,
};
if (hasConfirmedPhone) schema.telephone = client.phoneForTel;
if (hasConfirmedAddress) {
  schema.address = {
    '@type': 'PostalAddress',
    addressLocality: client.address.addressLocality,
    addressRegion: client.address.addressRegion,
    addressCountry: client.address.addressCountry,
  };
}
---

<BaseLayout
  title={brand.name}
  description="Aerantis Holdings — trusted property solutions, project coordination, and tailored support, delivering long-term value for every client."
  schema={schema}
>
  <Header slot="header" transparent />

  <Hero
    topper="Professional Property Solutions"
    headingLines={['Creating Value.', 'Inspiring Confidence.']}
    description={brand.description}
    ctaLabel="Request a Consultation"
    ctaHref="/contact"
    secondaryLabel="Explore Services"
    secondaryHref="/services"
  />
  <TrustBar />
  <Services />
  <About />
  <Projects />
  <CTA />

  <Footer slot="footer" />
</BaseLayout>
