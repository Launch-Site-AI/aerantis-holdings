---
import { brand } from '../config/brand';

interface Props {
  /** When true, the header renders with no background over the hero and
   *  switches to a solid charcoal background once the user scrolls. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;

const nav = [
  { label: 'Home',     href: '/' },
  { label: 'About',    href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'Contact',  href: '/contact' },
];

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const stripBase = (path: string) => {
  const base = baseUrl;
  if (base !== '/' && path.startsWith(base)) {
    const stripped = path.slice(base.length);
    return stripped ? `/${stripped.replace(/^\//, '')}` : '/';
  }
  return path;
};

const currentPath = stripBase(Astro.url.pathname);
---

<header
  class:list={[
    'sticky top-0 z-50 w-full transition-colors duration-300',
    transparent
      ? 'bg-transparent border-b border-transparent data-[scrolled=true]:bg-background/95 data-[scrolled=true]:border-border/40 data-[scrolled=true]:backdrop-blur-sm'
      : 'bg-background/95 border-b border-border/40 backdrop-blur-sm',
  ]}
  data-base-url={baseUrl}
  data-transparent={transparent ? 'true' : 'false'}
  data-scrolled="false"
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <!-- Wordmark -->
    <a
      href={withBase('/')}
      class="font-heading text-xl font-semibold uppercase tracking-[0.25em] text-text transition-opacity hover:opacity-80"
    >
      {brand.name}
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={withBase(href)}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'relative py-2 text-xs font-medium uppercase tracking-[0.2em] transition-colors',
              isActive
                ? 'text-accent'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
            <span
              class:list={[
                'pointer-events-none absolute inset-x-0 -bottom-0.5 h-px transition-opacity',
                isActive ? 'bg-accent opacity-100' : 'bg-accent opacity-0',
              ]}
              aria-hidden="true"
            />
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden lg:flex">
      <a
        href={withBase('/contact')}
        class="inline-flex min-h-[44px] items-center border border-accent px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.2em] text-accent transition-colors hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Request a Consultation
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center text-text-muted transition-colors hover:text-accent lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border/40 bg-background px-4 pb-6 pt-4 lg:hidden"
  >
    <nav class="flex flex-col" aria-label="Mobile navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={withBase(href)}
            class:list={[
              'border-b border-border/20 px-2 py-4 text-sm font-medium uppercase tracking-[0.2em] transition-colors',
              isActive
                ? 'text-accent'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-6">
      <a
        href={withBase('/contact')}
        class="flex min-h-[44px] items-center justify-center border border-accent px-5 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-accent transition-colors hover:bg-accent hover:text-accent-fg"
      >
        Request a Consultation
      </a>
    </div>
  </div>
</header>

<script>
  (() => {
    const activeClass = 'text-accent';
    const inactiveDesktop = ['text-text-muted', 'hover:text-text'];
    const inactiveMobile = ['text-text-muted', 'hover:text-text'];
    /** @type {() => void} */
    let teardown = () => {};

    /**
     * @param {string} rawPath
     * @param {string} baseUrl
     */
    const normalizePath = (rawPath, baseUrl) => {
      if (!rawPath) return '/';
      let path = rawPath;

      if (/^[a-zA-Z]+:/.test(path)) {
        try {
          path = new URL(path, window.location.origin).pathname;
        } catch {
          return '';
        }
      }

      if (!path.startsWith('/')) return '';

      if (baseUrl !== '/' && path.startsWith(baseUrl)) {
        const stripped = path.slice(baseUrl.length);
        path = stripped ? `/${stripped.replace(/^\/+/, '')}` : '/';
      }

      const collapsed = path.replace(/\/+/g, '/');
      return collapsed.length > 1 ? collapsed.replace(/\/+$/, '') : collapsed;
    };

    const isPathActive = (href, currentPath) => {
      if (!href) return false;
      if (href === '/') return currentPath === '/';
      return currentPath === href || currentPath.startsWith(`${href}/`);
    };

    const initHeader = () => {
      teardown();

      const headerEl = document.querySelector('header[data-base-url]');
      if (!headerEl) return;

      const header = /** @type {HTMLElement} */ (headerEl);
      const btn = /** @type {HTMLButtonElement | null} */ (header.querySelector('#menu-toggle'));
      const menu = /** @type {HTMLElement | null} */ (header.querySelector('#mobile-menu'));
      const iconOpen = /** @type {HTMLElement | null} */ (header.querySelector('#menu-icon-open'));
      const iconClose = /** @type {HTMLElement | null} */ (header.querySelector('#menu-icon-close'));
      if (!btn || !menu || !iconOpen || !iconClose) return;

      const baseUrl = header.dataset.baseUrl || '/';
      const isTransparent = header.dataset.transparent === 'true';
      const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

      const setMenuOpen = (nextOpen) => {
        if (isDesktop()) nextOpen = false;
        btn.setAttribute('aria-expanded', String(nextOpen));
        menu.classList.toggle('hidden', !nextOpen);
        iconOpen.classList.toggle('hidden', nextOpen);
        iconClose.classList.toggle('hidden', !nextOpen);
      };

      const syncActiveLinks = (nextPath = window.location.pathname) => {
        const path = normalizePath(nextPath, baseUrl);
        const desktopLinks = header.querySelectorAll('nav[aria-label="Primary navigation"] a');
        const mobileLinks = header.querySelectorAll('#mobile-menu nav a');

        desktopLinks.forEach((link) => {
          const href = normalizePath(link.getAttribute('href') || '', baseUrl);
          const isActive = isPathActive(href, path);
          link.classList.toggle(activeClass, isActive);
          link.classList.toggle(inactiveDesktop[0], !isActive);
          link.classList.toggle(inactiveDesktop[1], !isActive);
          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');

          const underline = link.querySelector('span[aria-hidden="true"]');
          if (underline) {
            underline.classList.toggle('opacity-100', isActive);
            underline.classList.toggle('opacity-0', !isActive);
          }
        });

        mobileLinks.forEach((link) => {
          const href = normalizePath(link.getAttribute('href') || '', baseUrl);
          const isActive = isPathActive(href, path);
          link.classList.toggle(activeClass, isActive);
          link.classList.toggle(inactiveMobile[0], !isActive);
          link.classList.toggle(inactiveMobile[1], !isActive);
          if (isActive) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      };

      const syncScrolled = () => {
        if (!isTransparent) return;
        const scrolled = window.scrollY > 16;
        header.dataset.scrolled = String(scrolled);
      };

      const handleBtnClick = () => {
        if (isDesktop()) return;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      };

      const handleMenuClick = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('a[href]')) setMenuOpen(false);
      };

      const handleHeaderClick = (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const navLink = target.closest('nav[aria-label="Primary navigation"] a, #mobile-menu nav a');
        if (!(navLink instanceof HTMLAnchorElement)) return;
        syncActiveLinks(navLink.getAttribute('href') || window.location.pathname);
      };

      const handleBeforePreparation = () => setMenuOpen(false);
      const handleAfterSwap = () => {
        setMenuOpen(false);
        syncActiveLinks();
        syncScrolled();
      };
      const handleResize = () => setMenuOpen(false);
      const handleScroll = () => syncScrolled();

      btn.addEventListener('click', handleBtnClick);
      menu.addEventListener('click', handleMenuClick);
      header.addEventListener('click', handleHeaderClick);
      document.addEventListener('astro:before-preparation', handleBeforePreparation);
      document.addEventListener('astro:after-swap', handleAfterSwap);
      window.addEventListener('resize', handleResize);
      window.addEventListener('scroll', handleScroll, { passive: true });

      teardown = () => {
        btn.removeEventListener('click', handleBtnClick);
        menu.removeEventListener('click', handleMenuClick);
        header.removeEventListener('click', handleHeaderClick);
        document.removeEventListener('astro:before-preparation', handleBeforePreparation);
        document.removeEventListener('astro:after-swap', handleAfterSwap);
        window.removeEventListener('resize', handleResize);
        window.removeEventListener('scroll', handleScroll);
      };

      setMenuOpen(false);
      syncActiveLinks();
      syncScrolled();
    };

    document.addEventListener('astro:page-load', initHeader);
    initHeader();
  })();
</script>
