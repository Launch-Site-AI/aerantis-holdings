---
interface Props {
  title: string;
}

const { title } = Astro.props;

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const stripBase = (path: string) => {
  const base = baseUrl;
  if (base !== '/' && path.startsWith(base)) {
    const stripped = path.slice(base.length);
    return stripped ? `/${stripped.replace(/^\//, '')}` : '/';
  }
  return path;
};

const segments = stripBase(Astro.url.pathname)
  .split('/')
  .filter(Boolean)
  .map((seg, i, arr) => ({
    label: seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
    href: '/' + arr.slice(0, i + 1).join('/'),
    isLast: i === arr.length - 1,
  }));
---

<section class="border-b border-primary/30 bg-surface pt-24 pb-14 sm:pt-28 sm:pb-16 lg:pt-32 lg:pb-20">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.24em] text-text-muted">
        <li>
          <a href={withBase('/')} class="transition-colors hover:text-primary">Home</a>
        </li>
        {segments.map(({ label, href, isLast }) => (
          <li class="flex items-center gap-2">
            <svg class="size-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
            </svg>
            {isLast ? (
              <span aria-current="page" class="text-text">{label}</span>
            ) : (
              <a href={withBase(href)} class="transition-colors hover:text-primary">{label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <h1 class="font-heading text-h1 font-medium leading-tight text-text">
      {title}
    </h1>
  </div>
</section>
