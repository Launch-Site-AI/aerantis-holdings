---
import { brand } from '../config/brand';
import { client } from '../data/client';
import { logoLockup, logoAltText } from '../config/images';

const year = new Date().getFullYear();
const displayDomain = client.domain.replace(/^https?:\/\//, '');
const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};

// Footer lockup: h-14 (56 px), width derived from intrinsic aspect ratio.
const lockupH = 56;
const lockupW = Math.round(lockupH * (logoLockup.width / logoLockup.height));

const navCols = [
  {
    title: 'Company',
    links: [
      { label: 'About',    href: '/about' },
      { label: 'Services', href: '/services' },
      { label: 'Projects', href: '/projects' },
    ],
  },
  {
    title: 'Support',
    links: [
      { label: 'Contact',  href: '/contact' },
    ],
  },
];

const hasAddress = Boolean(
  client.address.lineOne && !client.address.lineOne.startsWith('TODO')
    && client.address.city && !client.address.city.startsWith('TODO')
);
---

<footer class="border-t border-primary/30 bg-background text-text-muted" transition:persist>
  <div class="mx-auto max-w-site px-4 py-14 sm:px-6 lg:py-20">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">

      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href={withBase('/')}
          aria-label={`${logoAltText} — Home`}
          class="inline-flex items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        >
          <img
            src={logoLockup.src}
            width={lockupW}
            height={lockupH}
            alt=""
            aria-hidden="true"
            class="block h-14 w-auto"
            decoding="async"
          />
          <span class="sr-only">{brand.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed">
          {brand.tagline}
        </p>

        {(client.socials.facebook || client.socials.instagram || client.socials.google) && (
          <div class="mt-6 flex items-center gap-3">
            {client.socials.facebook && (
              <a href={client.socials.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex size-9 items-center justify-center border border-primary/40 text-primary transition-colors hover:border-primary hover:text-primary-light">
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
              </a>
            )}
            {client.socials.instagram && (
              <a href={client.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex size-9 items-center justify-center border border-primary/40 text-primary transition-colors hover:border-primary hover:text-primary-light">
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
              </a>
            )}
            {client.socials.google && (
              <a href={client.socials.google} target="_blank" rel="noopener noreferrer" aria-label="Google Business" class="flex size-9 items-center justify-center border border-primary/40 text-primary transition-colors hover:border-primary hover:text-primary-light">
                <svg class="size-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z" /></svg>
              </a>
            )}
          </div>
        )}
      </div>

      {navCols.map((col) => (
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">{col.title}</h3>
          <ul class="mt-5 space-y-3">
            {col.links.map(({ label, href }) => (
              <li>
                <a href={withBase(href)} class="text-sm transition-colors hover:text-text">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.28em] text-primary">Contact</h3>
        <ul class="mt-5 space-y-3 text-sm">
          {client.phoneFormatted && (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href={`tel:${client.phoneForTel}`} class="transition-colors hover:text-text">{client.phoneFormatted}</a>
            </li>
          )}
          {client.email && (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${client.email}`} class="break-all transition-colors hover:text-text">{client.email}</a>
            </li>
          )}
          {client.domain && (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3a9 9 0 100 18 9 9 0 000-18zm0 0a13 13 0 010 18M3.6 9h16.8M3.6 15h16.8" />
              </svg>
              <a href={client.domain} target="_blank" rel="noopener noreferrer" class="break-all transition-colors hover:text-text">{displayDomain}</a>
            </li>
          )}
          {hasAddress && (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 size-4 shrink-0 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21s7-6.75 7-12a7 7 0 10-14 0c0 5.25 7 12 7 12z" />
                <circle cx="12" cy="9" r="2.5" stroke-width="1.5" />
              </svg>
              {client.address.mapLink ? (
                <a href={client.address.mapLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-text">
                  {client.address.lineOne}<br />
                  {client.address.city}, {client.address.state} {client.address.zip}
                </a>
              ) : (
                <span>
                  {client.address.lineOne}<br />
                  {client.address.city}, {client.address.state} {client.address.zip}
                </span>
              )}
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-primary/20 pt-6 text-center text-xs uppercase tracking-[0.24em] text-text-muted">
      &copy; {year} {brand.name}. All rights reserved.
    </div>
  </div>
</footer>
