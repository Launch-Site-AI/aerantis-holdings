---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import {
  skylineImage as ownerSkyline,
  panelImage as ownerPanel,
} from '../config/images';
import skylinePlaceholder from '../assets/placeholders/skyline.svg?url';
import panelPlaceholder from '../assets/placeholders/panel.svg?url';

interface Props {
  topper?: string;
  subline?: string;
  headingLines?: [string, string];
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  skyline?: ImageMetadata;
  skylineAlt?: string;
  panel?: ImageMetadata;
  panelAlt?: string;
}

const {
  topper = 'Professional Property Solutions',
  subline = '',
  headingLines = ['Creating Value.', 'Inspiring Confidence.'],
  description = brand.description,
  ctaLabel = 'Request a Consultation',
  ctaHref = '/contact',
  secondaryLabel = 'Explore Services',
  secondaryHref = '/services',
  skyline = ownerSkyline,
  skylineAlt = 'Melbourne skyline at sunset',
  panel = ownerPanel,
  panelAlt = 'Aerantis project coordination on-site — blueprint review during a workplace fit-out',
} = Astro.props;

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const resolvedCtaHref = ctaHref.startsWith('/') ? withBase(ctaHref) : ctaHref;
const resolvedSecondaryHref = secondaryHref.startsWith('/') ? withBase(secondaryHref) : secondaryHref;
---

<section
  class="relative isolate overflow-hidden bg-background text-text"
  aria-label="Hero"
>
  <div class="grid min-h-[85vh] grid-cols-1 lg:grid-cols-[3fr_2fr]">

    <!-- ── Left column — skyline + copy ────────────────────────────── -->
    <div class="relative flex min-h-[70vh] items-end overflow-hidden lg:min-h-[85vh]">
      <div class="absolute inset-0" transition:name="hero-image">
        {skyline ? (
          <Image
            src={skyline}
            alt={skylineAlt}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 60vw, 100vw"
            loading="eager"
            decoding="async"
            class="size-full object-cover"
          />
        ) : (
          <img
            src={skylinePlaceholder}
            alt=""
            aria-hidden="true"
            class="size-full object-cover"
          />
        )}
      </div>

      <!-- Dark editorial overlay — keeps ivory copy AA-legible over skyline -->
      <div
        class="absolute inset-0 bg-linear-to-tr from-background/95 via-background/80 to-background/40"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-background/95 to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mx-auto flex w-full max-w-2xl flex-col gap-8 px-6 pb-16 pt-32 sm:px-10 sm:pb-24 sm:pt-40 lg:mx-0 lg:ml-auto lg:pr-16">
        {topper && (
          <span class="inline-flex items-center gap-3 text-xs font-medium uppercase tracking-[0.3em] text-accent">
            <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
            {topper}
          </span>
        )}

        <h1
          class="font-heading text-display font-medium leading-[1.05] tracking-tight text-text"
          transition:name="hero-heading"
        >
          <span class="block">{headingLines[0]}</span>
          <span class="block">{headingLines[1]}</span>
        </h1>

        {subline && (
          <p class="text-xs font-medium uppercase tracking-[0.28em] text-text-muted">
            {subline}
          </p>
        )}

        <p class="max-w-xl text-lead leading-relaxed text-text-muted">
          {description}
        </p>

        <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center">
          <a
            href={resolvedCtaHref}
            class="inline-flex min-h-[44px] items-center justify-center border border-accent bg-accent px-8 py-3 text-xs font-semibold uppercase tracking-[0.25em] text-accent-fg transition-colors hover:bg-transparent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {ctaLabel}
          </a>
          <a
            href={resolvedSecondaryHref}
            class="inline-flex min-h-[44px] items-center justify-center border border-accent/60 px-8 py-3 text-xs font-semibold uppercase tracking-[0.25em] text-accent transition-colors hover:border-accent hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {secondaryLabel}
          </a>
        </div>
      </div>
    </div>

    <!-- ── Right column — architectural panel ──────────────────────── -->
    <div class="relative hidden overflow-hidden border-l border-border/40 lg:block">
      <div class="absolute inset-0">
        {panel ? (
          <Image
            src={panel}
            alt={panelAlt}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(min-width: 1024px) 40vw, 0px"
            loading="eager"
            decoding="async"
            class="size-full object-cover object-right"
          />
        ) : (
          <img
            src={panelPlaceholder}
            alt=""
            aria-hidden="true"
            class="size-full object-cover"
          />
        )}
      </div>

      <!-- Vertical divisions -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <span class="absolute inset-y-0 left-1/3 w-px bg-border/50"></span>
        <span class="absolute inset-y-0 left-2/3 w-px bg-border/50"></span>
      </div>

      <!-- Subtle horizontal accents -->
      <div class="pointer-events-none absolute inset-x-0 top-24 h-px bg-accent/25" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-24 h-px bg-accent/25" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Bottom hairline separating hero from trust strip -->
  <div class="absolute inset-x-0 bottom-0 h-px bg-border/40" aria-hidden="true"></div>
</section>
