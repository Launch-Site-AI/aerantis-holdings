---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { aboutImage as ownerAbout } from '../config/images';

interface Props {
  topper?: string;
  heading?: string;
  body?: string[];
  benefits?: string[];
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata;
  imageAlt?: string;
}

const {
  topper = 'About Aerantis',
  heading = 'A considered approach to property.',
  body = [
    'Aerantis Holdings provides professional property solutions, project coordination and client-focused support throughout Melbourne.',
    'We believe successful projects begin with trust, clear communication and attention to detail.',
  ],
  benefits = [
    'Integrity',
    'Professionalism',
    'Reliability',
    'Long-term Relationships',
  ],
  ctaLabel = 'More About Aerantis',
  ctaHref = '/about',
  imageSrc = ownerAbout,
  imageAlt = 'Aerantis Holdings',
} = Astro.props;

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const resolvedCtaHref = ctaHref.startsWith('/') ? withBase(ctaHref) : ctaHref;
---

<section class="bg-background py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">

    <!-- Image / fallback panel -->
    <div class="relative aspect-[4/5] overflow-hidden border border-border/60">
      {imageSrc ? (
        <Image
          src={imageSrc}
          alt={imageAlt}
          width={800}
          height={1000}
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      ) : (
        <div
          class="flex size-full items-center justify-center bg-surface"
          aria-hidden="true"
        >
          <span class="font-heading text-sm uppercase tracking-[0.35em] text-text-muted">
            TODO(owner): image
          </span>
        </div>
      )}
      <span
        class="pointer-events-none absolute inset-4 border border-accent/30"
        aria-hidden="true"
      ></span>
    </div>

    <!-- Content -->
    <div class="space-y-6">
      <span class="inline-flex items-center gap-3 text-xs font-medium uppercase tracking-[0.3em] text-accent">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        {topper}
      </span>

      <h2 class="font-heading text-h2 font-medium leading-tight tracking-tight text-text">
        {heading}
      </h2>

      {body.map((paragraph) => (
        <p class="text-lead leading-relaxed text-text-muted">{paragraph}</p>
      ))}

      <ul class="space-y-4 border-t border-border/40 pt-6" role="list">
        {benefits.map((benefit) => (
          <li class="flex items-start gap-4">
            <svg
              class="mt-1 size-5 shrink-0 text-accent"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.5 4.5L19 7.5" />
            </svg>
            <span class="text-text">{benefit}</span>
          </li>
        ))}
      </ul>

      <div class="pt-2">
        <a
          href={resolvedCtaHref}
          class="inline-flex min-h-[44px] items-center gap-3 border border-accent px-8 py-3 text-xs font-semibold uppercase tracking-[0.25em] text-accent transition-colors hover:bg-accent hover:text-accent-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {ctaLabel}
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
