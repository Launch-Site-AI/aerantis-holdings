---
import { Image } from "astro:assets";
import { projectImages as defaultImages } from "../config/images";
import type { ProjectImage } from "../config/images";

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  images?: ProjectImage[];
  ctaLabel?: string | null;
  ctaHref?: string;
}

const {
  topper = "Portfolio",
  heading = "Selected Projects",
  description = "A considered portfolio of engagements. TODO(owner): supply a short lede.",
  images = defaultImages,
  ctaLabel = "View All Projects",
  ctaHref = "/projects",
} = Astro.props;

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const resolvedCtaHref = ctaHref.startsWith('/') ? withBase(ctaHref) : ctaHref;
---

<section class="bg-background py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-12 max-w-2xl text-center lg:mb-16">
      <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
        <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
        {topper}
        <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
      </span>
      <h2 class="mt-4 font-heading text-h2 font-medium leading-tight text-text">
        {heading}
      </h2>
      <p class="mt-4 text-text-muted leading-relaxed">{description}</p>
    </div>

    {images.length === 0 ? (
      <div class="mx-auto flex max-w-xl flex-col items-center justify-center gap-4 border border-primary/30 bg-surface p-12 text-center">
        <span class="h-px w-10 bg-primary" aria-hidden="true"></span>
        <p class="text-xs uppercase tracking-[0.28em] text-text-muted">
          TODO(owner): supply project photography.
        </p>
        <p class="text-sm text-text-muted">
          Drop 4:3 landscape images into <code class="font-mono text-primary/90">src/assets/images/projects/</code> and they will appear here automatically.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {images.map(({ src, alt }) => (
          <div
            class="group relative aspect-4/3 overflow-hidden border border-transparent bg-surface transition-colors duration-300 hover:border-primary"
            data-gallery-item
          >
            <div
              class="absolute inset-0 animate-pulse bg-linear-to-r from-surface via-border to-surface"
              aria-hidden="true"
              data-skeleton
            />

            <Image
              src={src}
              alt={alt}
              width={800}
              height={600}
              loading="lazy"
              decoding="async"
              class="relative size-full object-cover opacity-0 transition-all duration-500 group-hover:scale-105"
              data-gallery-img
            />

            <div
              class="absolute inset-0 hidden flex-col items-center justify-center gap-2 bg-surface text-sm text-text-muted"
              data-error-state
              aria-label="Image unavailable"
            >
              <svg class="size-8 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-xs uppercase tracking-[0.24em]">Image unavailable</span>
            </div>

            <div class="absolute inset-x-0 bottom-0 flex items-end bg-linear-to-t from-near-black/85 via-near-black/40 to-transparent p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <p class="font-heading text-sm font-medium tracking-wide text-text">{alt}</p>
            </div>
          </div>
        ))}
      </div>
    )}

    {ctaLabel && images.length > 0 && (
      <div class="mt-14 text-center">
        <a
          href={resolvedCtaHref}
          class="group inline-flex min-h-[48px] items-center justify-center gap-3 border border-primary px-10 py-3 text-sm font-semibold uppercase tracking-[0.28em] text-primary transition-colors hover:bg-primary hover:text-near-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <svg class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  function initGallery() {
    document.querySelectorAll<HTMLElement>("[data-gallery-item]").forEach((item) => {
      const img = item.querySelector<HTMLImageElement>("[data-gallery-img]");
      const skeleton = item.querySelector<HTMLElement>("[data-skeleton]");
      const errorState = item.querySelector<HTMLElement>("[data-error-state]");
      if (!img || !skeleton || !errorState) return;

      function onLoad() {
        img!.classList.remove("opacity-0");
        skeleton!.remove();
      }

      function onError() {
        skeleton!.remove();
        img!.classList.add("hidden");
        errorState!.classList.remove("hidden");
        errorState!.classList.add("flex");
      }

      if (img.complete) {
        img.naturalWidth > 0 ? onLoad() : onError();
        return;
      }

      img.addEventListener("load", onLoad, { once: true });
      img.addEventListener("error", onError, { once: true });
    });
  }

  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>
