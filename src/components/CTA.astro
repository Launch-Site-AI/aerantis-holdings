---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  title = 'Request a Consultation',
  description = 'Partnering with you to achieve lasting value.',
  buttonText = 'Request a Consultation',
  buttonHref = '/contact',
} = Astro.props;

const baseUrl = (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/';
const withBase = (path: string) => {
  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${normalizedBase}${path.replace(/^\/+/, '')}`;
};
const resolvedButtonHref = buttonHref.startsWith('/') ? withBase(buttonHref) : buttonHref;
---

<section class="relative border-y border-primary/30 bg-background py-section">
  <div class="mx-auto max-w-site px-4 text-center sm:px-6">
    <span class="inline-flex items-center gap-3 text-topper font-semibold uppercase tracking-[0.28em] text-primary">
      <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
      Aerantis Holdings
      <span class="h-px w-8 bg-primary/60" aria-hidden="true"></span>
    </span>
    <h2 class="mx-auto mt-4 max-w-2xl font-heading text-h2 font-medium leading-tight text-text">
      {title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-text-muted leading-relaxed">
      {description}
    </p>

    <div class="mt-10 flex justify-center">
      <a
        href={resolvedButtonHref}
        class="group inline-flex min-h-[48px] items-center justify-center gap-3 border border-primary bg-primary px-10 py-3 text-sm font-semibold uppercase tracking-[0.28em] text-near-black transition-colors hover:bg-primary-light hover:border-primary-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
      >
        {buttonText}
        <svg class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>
